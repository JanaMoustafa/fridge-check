{
  "name": "fridge-check",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm validate:data && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "check:css": "tsx scripts/check-logical-css.ts",
    "check:bundle": "tsx scripts/check-client-bundle.ts",
    "seed": "tsx scripts/seed-local-recipes.ts",
    "seed:nutrition": "tsx --env-file-if-exists=.env.local scripts/seed-nutrition.ts",
    "validate:data": "tsx scripts/validate-data.ts",
    "db:migrate": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts",
    "db:migrate:prod": "tsx --env-file-if-exists=.env.local scripts/db-migrate.ts --production",
    "pro:grant": "tsx --env-file-if-exists=.env.local scripts/pro-grant.ts grant",
    "pro:revoke": "tsx --env-file-if-exists=.env.local scripts/pro-grant.ts revoke",
    "pro:grant:prod": "tsx --env-file-if-exists=.env.local scripts/pro-grant.ts grant --production",
    "pro:revoke:prod": "tsx --env-file-if-exists=.env.local scripts/pro-grant.ts revoke --production"
  },
  "dependencies": {
    "@tanstack/query-async-storage-persister": "5.104.1",
    "@tanstack/react-query": "5.104.1",
    "@tanstack/react-query-persist-client": "5.104.1",
    "@vercel/functions": "3.9.11",
    "better-auth": "1.7.7",
    "kysely": "0.29.6",
    "lucide-react": "1.52.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "pg": "8.23.1",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.104.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^24.19.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "30.1.2",
    "kysely-pglite-dialect": "1.3.1",
    "msw": "3.0.2",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": "24.x"
  }
}
