# Copy to .env.local and fill in what you need. Nothing here is required: the app works fully
# with RECIPE_PROVIDER=local and no API keys. Every variable except NEXT_PUBLIC_SITE_URL is read
# on the server only and never reaches the browser (`pnpm check:bundle` verifies this).

# Absolute public URL of the site, used for Open Graph and canonical links.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which source answers searches: local (the built-in collection, default), mealdb (TheMealDB's
# live API) or spoonacular (needs SPOONACULAR_API_KEY). If a remote source fails, runs out of
# quota or takes longer than 8 s, the built-in collection answers and the page says so.
RECIPE_PROVIDER=local

# Spoonacular key (https://spoonacular.com/food-api/console#Profile). Sent in the x-api-key
# header from the server only. The free plan allows 50 points a day (a search costs about 3,
# a recipe page about 1); after a 402 the app stops calling Spoonacular until midnight UTC and
# answers from the built-in collection. Also enables links to Spoonacular recipes.
SPOONACULAR_API_KEY=

# TheMealDB key. "1" is the free test key for development and education; a supporter key
# switches to the v2 API. Defaults to "1" when empty.
THEMEALDB_API_KEY=1

# Requests per minute per client IP on /api/recipes/* (in memory, per server instance).
# 0 turns limiting off. Defaults to 60.
RATE_LIMIT_PER_MINUTE=60

# --- Pro (sign-in, nutrition profile, payments) -------------------------------------------
# Postgres connection string (Neon, through its connection pooler). On Vercel the Neon
# integration sets it; locally, copy it from Neon → Connect. Apply schema changes with
# `pnpm db:migrate` (`pnpm db:migrate down` reverts the latest, `status` lists them).
DATABASE_URL=

# Sign-in (Better Auth + Google). With DATABASE_URL these five turn the account and Pro features
# on; without any of them the app runs as the free, account-free version.
# A random secret of at least 32 characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The site's public origin: http://localhost:3000 locally, the production URL on Vercel.
BETTER_AUTH_URL=http://localhost:3000
# Google Cloud → Google Auth Platform → Clients (Web application). Authorized redirect URI:
# <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# XPay Egypt (Developers → API keys / Webhooks). Test mode keys start with sk_test_; the webhook
# endpoint is <site>/api/webhooks/xpay and its signing secret starts with whsec_.
XPAY_SECRET_KEY=
XPAY_WEBHOOK_SECRET=

# USDA FoodData Central key, used only by `pnpm seed:nutrition` (not by the running app).
# Free: https://fdc.nal.usda.gov/api-key-signup
FDC_API_KEY=
