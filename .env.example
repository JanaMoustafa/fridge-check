# Copy to .env.local and fill in what you need. Nothing here is required: the app works fully
# with RECIPE_PROVIDER=local and no API keys.

# Absolute public URL of the site, used for Open Graph and canonical links.
# On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used automatically when this is empty.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
